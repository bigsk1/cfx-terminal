FROM python:3.12-slim

WORKDIR /app

# Install tools for diagnostics and healthcheck
RUN apt-get update && apt-get install -y curl netcat-traditional net-tools && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY backend/requirements.txt .

# Install dependencies with specific OpenAI version that's compatible with Python 3.12
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir --upgrade "openai>=1.15.0"

# Copy backend code
COPY backend/ .
COPY .env .

# Create directory for temp images
RUN mkdir -p temp_images

# Expose the port the app runs on
EXPOSE 8000

# Command to run the application
CMD ["python", "-m", "uvicorn", "docker_app:app", "--host", "0.0.0.0", "--port", "8000"] 